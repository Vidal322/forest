# First run:  cp .env.example .env  &&  docker compose up -d
# .env is git-ignored. Used by docker compose and the API.

# Local development only — change the password anywhere else.
POSTGRES_USER=forest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forest
POSTGRES_PORT=5433

# API
FOREST_HTTP_ADDR=127.0.0.1:8080
FOREST_LOG_LEVEL=info
# Keep in sync with the POSTGRES_* values above. sslmode=disable is for local use only.
DATABASE_URL=postgres://forest:change-me@127.0.0.1:5433/forest?sslmode=disable

# Uploaded photos are kept in $FOREST_DATA_DIR/photos (default: ./data)
# FOREST_DATA_DIR=data

# Serve the built app (cd ../frontend && pnpm build) from the API too: one address for the phone.
# FOREST_STATIC_DIR=../frontend/dist
